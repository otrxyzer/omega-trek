import pandas as pd
import numpy as np
import yfinance as yf
from datetime import datetime, timedelta

def extract_market_data(ticker: str, days_back: int = 365):
    """EXTRACT: Mengambil data historis dari Yahoo Finance"""
    print(f"[ETL - EXTRACT] Mengambil data untuk {ticker}...")
    end_date = datetime.now()
    start_date = end_date - timedelta(days=days_back)
    
    # Fetch data menggunakan yfinance
    df = yf.download(ticker, start=start_date.strftime('%Y-%m-%d'), end=end_date.strftime('%Y-%m-%d'))
    if df.empty:
        raise ValueError(f"Data tidak ditemukan untuk ticker: {ticker}")
    return df

def transform_market_data(df: pd.DataFrame):
    """TRANSFORM: Membersihkan data dan menghitung volatilitas historis (sigma)"""
    print("[ETL - TRANSFORM] Memproses data dan menghitung volatilitas harian...")
    
    # Memastikan struktur kolom datar jika menggunakan yfinance versi terbaru
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = df.columns.droplevel(1)
        
    df = df'Close'.copy()
    df.dropna(inplace=True)
    
    # 1. Hitung Log Return harian
    df['Log_Return'] = np.log(df['Close'] / df['Close'].shift(1))
    
    # 2. Hitung Volatilitas Historis Tahunan (Sigma)
    daily_volatility = df['Log_Return'].std()
    annual_volatility = daily_volatility * np.sqrt(252) # 252 hari bursa dalam setahun
    
    current_price = float(df['Close'].iloc[-1])
    
    return current_price, annual_volatility

def load_to_summary(ticker, price, volatility):
    """LOAD: Memuat hasil transformasi ke dalam struktur dictionary siap pakai"""
    print("[ETL - LOAD] Memuat metrik pasar ke Command Center...")
    market_metrics = {
        "ticker": ticker,
        "current_price": round(price, 2),
        "annual_volatility": round(volatility, 4),
        "timestamp": datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    }
    return market_metrics

def run_etl_pipeline(ticker: str):
    """Fungsi utama orchestrator ETL"""
    raw_data = extract_market_data(ticker)
    price, volatility = transform_market_data(raw_data)
    metrics = load_to_summary(ticker, price, volatility)
    return metrics


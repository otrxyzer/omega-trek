import numpy as np

def stirling_log_factorial(n):
    """
    Menghitung ln(n!) menggunakan Stirling Approximation Versi Akurat.
    Sangat berguna untuk n besar agar menghindari integer overflow.
    """
    if n == 0 or n == 1:
        return 0.0
    # Formula: ln(n!) ≈ 0.5 * ln(2 * pi * n) + n * ln(n) - n
    return 0.5 * np.log(2 * np.pi * n) + n * np.log(n) - n

def risk_neutral_probability(R, d, u):
    """Menghitung probabilitas netral risiko (p)"""
    return (R - d) / (u - d)

def binomial_stirling_option_pricing(S, X, T, r, sigma, n, option_type='call'):
    """
    Pricing Opsi Eropa menggunakan Kombinasi Pohon Binomial & Stirling Approximation
    untuk menghitung kombinasi binomial n! / (k!(n-k)!) pada n skala besar.
    """
    dt = T / n
    R = np.exp(r * dt) # Faktor diskonto kontinu
    
    # Parameter pergerakan harga CRR (Cox-Ross-Rubinstein)
    u = np.exp(sigma * np.sqrt(dt))
    d = 1 / u
    
    p = risk_neutral_probability(R, d, u)
    
    # ln dari probabilitas untuk menghindari underflow pada perkalian berulang
    ln_p = np.log(p)
    ln_1_minus_p = np.log(1 - p)
    
    option_price = 0.0
    
    # Menghitung nilai ekspektasi pada waktu jatuh tempo (Terminal Nodes)
    for k in range(n + 1):
        # Hitung harga saham pada simpul ke-k di akhir periode
        S_t = S * (u ** k) * (d ** (n - k))
        
        # Hitung payoff opsi
        if option_type.lower() == 'call':
            payoff = max(S_t - X, 0)
        else:
            payoff = max(X - S_t, 0)
            
        if payoff > 0:
            # Hitung ln dari kombinasi binomial C(n,k) menggunakan Stirling
            ln_C_n_k = stirling_log_factorial(n) - (stirling_log_factorial(k) + stirling_log_factorial(n - k))
            
            # Hitung ln dari probabilitas binomial: ln [ C(n,k) * p^k * (1-p)^(n-k) ]
            ln_prob = ln_C_n_k + (k * ln_p) + ((n - k) * ln_1_minus_p)
            
            # Tambahkan ke total harga opsi (didiskontokan langsung)
            option_price += payoff * np.exp(ln_prob - r * T)
            
    return option_price

